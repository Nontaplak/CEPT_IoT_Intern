**Timescale db** __Now ignore 0 value streak < 3__
-- Create table for logging reset energy commands--
CREATE TABLE IF NOT EXISTS reset_logs (
    id SERIAL PRIMARY KEY,
    sensor_id INTEGER NOT NULL,
    timestamp TIMESTAMPTZ NOT NULL,
    request_id BIGINT NOT NULL,
    status VARCHAR(20) DEFAULT 'sent',
    created_at TIMESTAMPTZ DEFAULT NOW(),
    updated_at TIMESTAMPTZ DEFAULT NOW()
);

-- Create index for faster queries--
CREATE INDEX IF NOT EXISTS idx_reset_logs_sensor_timestamp 
ON reset_logs(sensor_id, timestamp DESC);

CREATE INDEX IF NOT EXISTS idx_reset_logs_request_id 
ON reset_logs(request_id);

 